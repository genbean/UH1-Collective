#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     MAJOR_VERSION, MINOR_VERSION, PATCH_VERSION, 0
PRODUCTVERSION  MAJOR_VERSION, MINOR_VERSION, PATCH_VERSION, 0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004B0"
        BEGIN
            VALUE "FileVersion",      APP_VERSION
            VALUE "ProductVersion",   APP_VERSION
            VALUE "FileDescription",  "HeliSR Configurator"
            VALUE "ProductName",      "HeliSR Configurator"
            VALUE "InternalName",     "HeliSRConfigurator"
            VALUE "OriginalFilename", "HeliSRConfigurator.exe"
            VALUE "CompanyName",      "HeliSR contributors"
            VALUE "LegalCopyright",   "(C) HeliSR contributors; based on FreeJoyConfiguratorQt (C) FreeJoy Team. GPL-3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0000, 0x04B0
    END
END

IDI_DB4S ICON "Images\\icon.ico"
